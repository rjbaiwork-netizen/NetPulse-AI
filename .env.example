# Core runtime
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./netpulse.db
# 32-byte base64/URL-safe key is recommended for AES-256-GCM
NETPULSE_ENCRYPTION_KEY=
# MikroTik defaults
MIKROTIK_HOST=
MIKROTIK_PORT=8729
MIKROTIK_USERNAME=
MIKROTIK_PASSWORD=
MIKROTIK_TLS=true
MIKROTIK_VERIFY_TLS=true
MIKROTIK_TIMEOUT=10
